<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#080A10"
                android:centerColor="#0D1017"
                android:endColor="#0F111A"
                android:angle="180" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#0D1838"
                android:endColor="#00000000"
                android:gradientRadius="600dp"
                android:centerX="0.8"
                android:centerY="0.1" />
        </shape>
    </item>
</layer-list>
