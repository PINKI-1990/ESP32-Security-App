<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:orientation="vertical">

    <!-- ═══ Header Toolbar ═══ -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivShieldIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_security_shield"
            app:tint="@color/primary"
            android:contentDescription="Security Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doorbell Sentinel"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP32-CAM Security Node"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:letterSpacing="0.03" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- ═══ Connection Status Card ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/connectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <!-- Status Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NODE STATUS"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/status_dot_disconnected" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Offline"
                                android:textColor="@color/status_disconnected_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Connect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Connect"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_bluetooth"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Live Feed Preview Card ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/liveFeedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Live Feed Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_videocam"
                            app:tint="#10B981" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="LIVE CAMERA"
                            android:textColor="#10B981"
                            android:textSize="12sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold" />

                        <!-- Pulsing live dot -->
                        <View
                            android:id="@+id/livePulseDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/ic_live_dot" />

                        <TextView
                            android:id="@+id/tvLiveFeedStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TAP TO VIEW"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Mini Preview Frame -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/live_feed_frame"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <ImageView
                            android:id="@+id/ivMiniPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Mini camera preview" />

                        <!-- Gradient overlay at bottom -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom" />

                        <!-- Camera Off Message -->
                        <LinearLayout
                            android:id="@+id/llCameraOff"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_videocam"
                                app:tint="#2D3142" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Camera feed offline"
                                android:textColor="#4B5563"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Open Live Feed Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenLiveFeed"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Open Live Feed"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#10B981"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_videocam"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Feed Section Title ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY ALERTS FEED"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <!-- ═══ Feed Container & Empty State ═══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp">

                <!-- Empty State Visual -->
                <LinearLayout
                    android:id="@+id/llEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_camera_feed"
                        app:tint="#1E2231"
                        android:contentDescription="Empty feed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="No motion alerts detected"
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Snapshots will appear here on detection"
                        android:textColor="#374151"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Feed cards container -->
                <LinearLayout
                    android:id="@+id/feedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>